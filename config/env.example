# Copy to <data directory>/.env  (default ~/.config/postweft/.env) and run: chmod 600 .env
# Never commit this file and never paste these values into a chat.

# Instagram Graph API token with instagram_basic, instagram_content_publish, instagram_manage_comments,
# instagram_manage_insights and, for DMs, instagram_manage_messages. A Page access token made from a long-lived
# user token does not expire.
INSTAGRAM_TOKEN=

# Threads API token (long-lived, 60 days; bin/refresh-tokens.mjs renews it) with threads_basic, threads_content_publish,
# threads_read_replies, threads_manage_replies, threads_manage_insights.
THREADS_TOKEN=

# YouTube (optional): a Google Cloud OAuth client of type "Desktop app" with the YouTube Data API v3 enabled.
# YOUTUBE_REFRESH_TOKEN is written by `node bin/connect.mjs youtube`; leave it empty.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# TikTok (optional): a developers.tiktok.com app with Login Kit + Content Posting API (scopes user.info.basic,
# video.upload). TIKTOK_REFRESH_TOKEN is written by `node bin/connect.mjs tiktok`; leave it empty.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=

# X (optional): an X Developer Console app with OAuth 2.0 and Read and Write permissions.
# The client secret is only needed for confidential apps. Connect writes the refresh token.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REFRESH_TOKEN=

# If config.json "ai.provider" or "voice.provider" is "gemini": a Gemini API key from Google AI Studio.
GEMINI_API_KEY=

# Only for the voice-over provider you choose in config.json "voice.provider":
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
