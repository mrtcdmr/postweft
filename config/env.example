# Copy to <data directory>/.env  (default ~/.config/social-autopilot/.env) and run: chmod 600 .env
# Never commit this file and never paste these values into a chat.

# Instagram Graph API token (long-lived) with instagram_basic, instagram_content_publish,
# instagram_manage_comments and, for DMs, instagram_manage_messages.
INSTAGRAM_TOKEN=

# Threads API token (long-lived) with threads_basic, threads_content_publish, threads_read_replies, threads_manage_replies.
THREADS_TOKEN=

# Only if config.json "ai.provider" is "gemini": a Gemini API key from Google AI Studio.
GEMINI_API_KEY=
